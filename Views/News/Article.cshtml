@model Article
@inject NewsRepository News
@{ ViewData["Title"] = Model.Title; var related = News.Articles.Where(a => a.Id != Model.Id).Take(3); }
<div class="shell article-layout"><article class="article"><div class="breadcrumb">Trang chủ <span>/</span> @Model.Category</div><div class="kicker">@Model.Category</div><h1>@Model.Title</h1><p class="deck">@Model.Summary</p><div class="byline"><b>@Model.Author</b><span>@Model.PublishedAt</span><button>♡ Lưu bài</button></div><img class="article-image" src="@Model.ImageUrl" alt="@Model.Title" /><p class="caption">Ảnh minh họa: Tin Việt</p><div class="article-body"><p>Trong nhịp chuyển động không ngừng của cuộc sống, những thay đổi gần gũi đang tạo nên một câu chuyện lớn hơn. Từ các góc phố quen thuộc đến những sáng kiến mới, mọi điều đều bắt đầu bằng sự quan tâm và tinh thần cùng nhau làm tốt hơn.</p><p>Ghi nhận thực tế cho thấy nhiều người trẻ đã chủ động tham gia, mang theo năng lượng tích cực và những góc nhìn khác biệt. Không chỉ là một hoạt động đơn lẻ, đây là cách cộng đồng tạo dựng kết nối bền vững.</p><blockquote>“Điều quan trọng nhất là mỗi người tìm được một cách đóng góp phù hợp, bắt đầu từ những điều nhỏ nhất.”</blockquote><p>Những câu chuyện tiếp theo sẽ còn được viết nên từ chính các trải nghiệm thường ngày. Tin Việt sẽ tiếp tục cập nhật các góc nhìn đa chiều và thông tin hữu ích đến bạn đọc.</p></div></article><aside class="article-aside"><h3>Đọc thêm</h3>@foreach (var item in related) { <a asp-action="Article" asp-route-id="@item.Id"><img src="@item.ImageUrl" alt="" /><span>@item.Category</span><b>@item.Title</b></a> }</aside></div>
