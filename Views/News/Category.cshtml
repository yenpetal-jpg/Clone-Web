@model IReadOnlyList<Article>
@{ var category = (string)ViewBag.Category; ViewData["Title"] = category; }
<div class="shell page category-page"><div class="category-heading"><span class="kicker">Chuyên mục</span><h1>@category</h1><p>Những câu chuyện, góc nhìn và thông tin mới nhất trong ngày.</p></div>@if (Model.Any()) { <section class="category-feature"><img src="@Model[0].ImageUrl" alt="@Model[0].Title" /><div><span class="kicker">@Model[0].PublishedAt</span><h2><a asp-action="Article" asp-route-id="@Model[0].Id">@Model[0].Title</a></h2><p>@Model[0].Summary</p></div></section> } else { <p class="empty">Chuyên mục này đang được cập nhật. Mời bạn khám phá các tin tức nổi bật khác.</p> }<section class="result-list">@foreach (var article in Model.Skip(1)) { <article class="result"><img src="@article.ImageUrl" alt="" /><div><span class="kicker">@article.PublishedAt</span><h2><a asp-action="Article" asp-route-id="@article.Id">@article.Title</a></h2><p>@article.Summary</p></div></article> }</section></div>
