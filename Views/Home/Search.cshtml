@model IReadOnlyList<Article>
@{ ViewData["Title"] = "Tìm kiếm"; var query = Context.Request.Query["q"].ToString(); }
<div class="shell page search-page"><p class="kicker">Tìm kiếm</p><h1>Kết quả cho “@query”</h1><form class="wide-search" asp-action="Search"><input name="q" value="@query" placeholder="Nhập từ khóa" /><button>Tìm kiếm</button></form><p class="result-count">Tìm thấy @Model.Count bài viết phù hợp</p><section class="result-list">@foreach (var article in Model) { <article class="result"><img src="@article.ImageUrl" alt="" /><div><div class="kicker">@article.Category</div><h2><a asp-controller="News" asp-action="Article" asp-route-id="@article.Id">@article.Title</a></h2><p>@article.Summary</p><span class="meta">@article.PublishedAt · @article.Author</span></div></article> }</section></div>
